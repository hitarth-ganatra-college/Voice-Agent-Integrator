# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for Whisper STT and (optionally) the GPT chatbot
OPENAI_API_KEY=sk-...

# ── Chatbot ───────────────────────────────────────────────────────────────────
# "openai"  → use OpenAI GPT (default)
# "custom"  → call an external HTTP endpoint (set CHATBOT_URL below)
CHATBOT_TYPE=openai

# Model used when CHATBOT_TYPE=openai
OPENAI_MODEL=gpt-3.5-turbo

# Endpoint called when CHATBOT_TYPE=custom
# It must accept  POST {"text": "<user utterance>"}
# and return      {"msg": "<agent reply>"}
CHATBOT_URL=

# System prompt injected into the GPT conversation
SYSTEM_PROMPT=You are a helpful, friendly voice assistant. Keep replies short and conversational.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
